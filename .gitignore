# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# zanii admin DID provisioning output (private keys — never commit)
.zanii-cth-keys.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

# verification blast — generated artifacts (no secrets in repo)
scripts/verification-blast.log
scripts/resume-cron.log
scripts/resume-launchd.out
scripts/resume-launchd.err
scripts/.verification-blast.DONE

# playwright
/test-results
/playwright-report
/playwright/.cache
/blob-report

# transient sprint artifacts
.claude/worktrees/
public/stalls.excel-extracted.json.bak
.gstack/
.migration-baseline.json

# session scratch files: never part of a deploy (Law 1: the tree is the manifest)
scratchpad/
tmp-*

# local session handoff state: regenerated each session, never tracked (git log
# confirms it has never been committed). Kept out so it never dirties the tree
# and never ships via vercel --prod.
.claude-session.md

# generated data exports: vendor spreadsheets written by ad-hoc export scripts.
# They contain vendor PII, so they must NEVER be committed OR shipped to prod
# (Law 2). Anchored to the repo root; the export scripts themselves stay tracked.
/exports/
